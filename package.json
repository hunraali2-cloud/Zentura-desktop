{
  "name": "zentura-cashier-desktop",
  "version": "1.0.0",
  "description": "Zentura POS - Sub-Second Thermal Printing & Multi-Tenant Cashier Desktop Terminal",
  "author": "Talal Sajid",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "dev": "vite --host --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "setup:electron": "node scripts/setup-electron.js",
    "setup:icons": "node scripts/generate-icons.js",
    "dist": "npm run build && electron-builder",
    "publish": "npm run build && electron-builder --publish always && node scripts/publish-updates.js",
    "publish:fast": "vite build && electron-builder --publish always -c.compression=store && node scripts/publish-updates.js",
    "publish:updates": "node scripts/publish-updates.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@zentura/database": "file:./packages/database",
    "@zentura/escpos-engine": "file:./packages/escpos-engine",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.zentura.cashier",
    "productName": "Zentura Cashier",
    "directories": {
      "output": "../zentura-releases-repo"
    },
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "public/zentura-logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "public/zentura-logo.ico",
      "uninstallerIcon": "public/zentura-logo.ico",
      "installerHeaderIcon": "public/zentura-logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zentura Cashier",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "hunraali2-cloud",
      "repo": "Zentura-releases",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "packages/**/*",
      "public/**/*"
    ]
  }
}
